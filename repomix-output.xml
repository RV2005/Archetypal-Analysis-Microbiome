    "ROOT = \".\"\n",
    "EXPORT_DIR = os.path.join(ROOT, \"final_plots\")\n",
    "Path(EXPORT_DIR).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "def set_paper_style():\n",
    "    plt.style.use(\"seaborn-v0_8-whitegrid\")\n",
    "    plt.rcParams.update(\n",
    "        {\n",
    "            \"font.family\": \"serif\",\n",
    "            \"font.serif\": [\"Times New Roman\", \"Times\", \"DejaVu Serif\"],\n",
    "            \"font.size\": 11,\n",
