   "source": [
    "comp_loader = CompendiumDataLoader()\n",
    "otu_for_composition = comp_loader.load_df(otu_file_for_composition, index_col=0)\n",
    "new_columns = []\n",
    "for col in otu_for_composition.columns:\n",
    "    segments = col.split(\".\")\n",
    "    if segments[-1].isdigit():\n",
    "        # Find the last segment that is not a number\n",
    "        for i in range(len(segments) - 2, -1, -1):\n",
    "            if not segments[i].isdigit():\n",
    "                new_columns.append(\".\".join(segments[:i + 1])+ f\"{segments[-1]}\")  # Append the index of the last non-numeric segment\n",
    "                break\n",
    "        else:\n",
    "            new_columns.append(col)  # If all segments are numbers, keep original\n",
    "    else:\n",
    "        new_columns.append(col)    \n",
    "otu_for_composition.columns = new_columns\n",
    "\n",
    "# Align feature names count with archetype width when possible\n",
    "if otu_for_composition.shape[1] != np.array(aa_archetypes).shape[1]:\n",
    "    raise ValueError(\n",
    "        \"OTU feature count does not match archetype feature count. \"\n",
    "        \"Please provide an OTU file aligned to the selected result feature space.\"\n",
    "    )\n",
    "\n",
    "composition_analyzer = CompositionAnalyzer()\n",
    "\n",
    "top_taxa_archs = composition_analyzer.analyze_top_taxa(\n",
    "    archetypes=np.array(aa_archetypes),\n",
    "    feature_names=otu_for_composition.columns.tolist(),\n",
    "    num_taxa=num_top_taxa,\n",
    ")\n",
    "\n",
    "composition_analyzer.plot_stacked_bar_chart(\n",
    "    aa_archetypes=np.array(aa_archetypes),\n",
    "    feature_names=otu_for_composition.columns.tolist(),\n",
    "    top_taxa_archetypes=top_taxa_archs,\n",
    "    figsize=(12, 6),\n",
    "    sort_by_contribution=False,\n",
    "    simplified_taxa_level=8,\n",
    ")\n",
    "plt.title(f\"Archetype Composition (Top {num_top_taxa} taxa + Others)\")\n",
    "plt.show()\n"
   ]
  },
