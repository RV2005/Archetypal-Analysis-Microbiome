    "# Plot PC1 and PC2 with Plotly for interactivity\n",
    "import plotly.express as px\n",
    "\n",
    "# Create new metadata with region, project, sample_type, condition, notes\n",
    "filter_cols = [\"region\", \"project\", \"sample_type\", \"condition\", \"notes\"]\n",
    "new_metadata = extract_metadata(otu.index, tags, meta, projects, filter_cols, verbose=False)\n",
    "\n",
    "# Get intersection of indices\n",
    "common_indices = pcoa_coords.index.intersection(new_metadata.index)\n",
    "filtered_pcoa_coords = pcoa_coords.loc[common_indices]\n",
    "filtered_metadata = new_metadata.loc[common_indices]\n",
    "\n",
    "fig = px.scatter(\n",
    "    filtered_pcoa_coords,\n",
    "    x='PC1',\n",
    "    y='PC2',\n",
    "    color=filtered_metadata['condition'],\n",
    "    hover_data={\n",
    "        'project': filtered_metadata['project'],\n",
    "        'sample_type': filtered_metadata['sample_type'],\n",
    "        'condition': filtered_metadata['condition'],\n",
    "        'notes': filtered_metadata['notes']\n",
    "    },\n",
    "    title='PCoA Plot (PC1 vs PC2) Colored by Region',\n",
    "    labels={'PC1': 'Principal Component 1', 'PC2': 'Principal Component 2'},\n",
    "    color_discrete_sequence=px.colors.qualitative.Set1\n",
    ")\n",
    "fig.show()\n",
    "# Fucked Projects\n",
    "# PRJNA399246\n",
    "# PRJNA396815\n",
    "# PRJNA558158\n",
    "# PRJNA606262"
   ]
