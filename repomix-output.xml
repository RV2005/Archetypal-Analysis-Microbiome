    "# Helper functions for loading and inference\n",
    "\n",
    "def discover_result_files(results_directory):\n",
    "    pattern = os.path.join(results_directory, \"otu_AA_K*.json\")\n",
    "    files = glob.glob(pattern)\n",
    "    k_to_file = {}\n",
    "    rx = re.compile(r\"otu_AA_K(\\d+).+\\.json$|otu_AA_K(\\d+)\\.json$\")\n",
    "\n",
    "    for fp in files:\n",
    "        name = os.path.basename(fp)\n",
    "        match = rx.search(name)\n",
    "        if not match:\n",
    "            continue\n",
    "        k_str = match.group(1) if match.group(1) is not None else match.group(2)\n",
    "        k = int(k_str)\n",
    "        if k not in k_to_file:\n",
    "            k_to_file[k] = fp\n",
    "\n",
    "    return dict(sorted(k_to_file.items(), key=lambda x: x[0]))\n",
    "\n",
    "\n",
    "def load_results_dict(k_to_file):\n",
    "    loader = ArchetypalResultLoader()\n",
    "    results = {}\n",
    "    for k, fp in k_to_file.items():\n",
    "        try:\n",
    "            results[k] = loader.load_result(fp)\n",
    "        except FileNotFoundError:\n",
    "            print(f\"Warning: Missing result for K={k}: {fp}\")\n",
    "    return results\n",
    "\n",
    "\n",
    "def infer_legend_type(metadata_df, col):\n",
    "    series = metadata_df[col]\n",
    "    numeric_series = pd.to_numeric(series, errors=\"coerce\")\n",
    "    n_valid_numeric = numeric_series.notna().sum()\n",
    "\n",
    "    if n_valid_numeric > 0:\n",
    "        return \"continuous\", numeric_series\n",
    "    return \"discrete\", series\n",
    "\n",
    "\n",
    "def load_metadata_auto(meta_path, projects_path=None, tags_path=None):\n",
    "    loader = CompendiumDataLoader()\n",
    "    _, projects, tags, meta = loader.load_all(\n",
    "        otu_file=None,\n",
    "        projects_file=projects_path,\n",
    "        tags_file=tags_path,\n",
    "        meta_file=meta_path,\n",
    "    )\n",
    "    return projects, tags, meta\n",
    "\n",
    "# Drop nan from metadata column\n",
    "def drop_nan_from_metadata(metadata_df, col):\n",
    "    before_count = metadata_df.shape[0]\n",
    "    metadata_df = metadata_df.dropna(subset=[col])\n",
    "    after_count = metadata_df.shape[0]\n",
    "    print(f\"Dropped {before_count - after_count} samples with NaN in '{col}'. Remaining samples: {after_count}.\")\n",
    "    return metadata_df\n",
    "\n",
    "\n",
    "def build_metadata_for_samples(sample_index, metadata_col, meta, projects=None, tags=None):\n",
    "    md = extract_metadata(\n",
    "        index=sample_index,\n",
    "        tags=tags,\n",
    "        sample_meta=meta,\n",
    "        projects=projects,\n",
    "        extract_cols=[metadata_col],\n",
    "        verbose=False,\n",
    "    )\n",
    "    return md\n",
    "\n",
    "\n",
    "def reorder_similarity_and_archetypes(otu_aa, aa_archetypes, order_cols=None):\n",
    "    if order_cols is None:\n",
    "        return otu_aa.copy(), np.array(aa_archetypes)\n",
    "\n",
    "    missing = [c for c in order_cols if c not in otu_aa.columns]\n",
    "    if missing:\n",
    "        raise ValueError(\n",
    "            f\"archetype_order contains columns not present in result: {missing}. \"\n",
    "            f\"Available columns: {list(otu_aa.columns)}\"\n",
    "        )\n",
    "\n",
    "    reordered = otu_aa[order_cols].copy()\n",
    "    renamed_cols = [f\"Archetype {i+1}\" for i in range(len(order_cols))]\n",
    "    reordered.columns = renamed_cols\n",
    "\n",
    "    idx = [int(c.split()[-1]) - 1 for c in order_cols]\n",
    "    aa_reordered = np.array(aa_archetypes)[idx, :]\n",
    "    return reordered, aa_reordered\n",
    "\n"
   ]
  },
