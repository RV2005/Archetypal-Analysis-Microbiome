    "def _integer_ticks_with_intermediates(min_val, max_val, max_intervals=6):\n",
    "    tick_min = int(np.rint(min_val))\n",
    "    tick_max = int(np.rint(max_val))\n",
    "    if tick_min > tick_max:\n",
    "        tick_min, tick_max = tick_max, tick_min\n",
    "    if tick_min == tick_max:\n",
    "        return np.array([tick_min], dtype=int)\n",
    "    n_intervals = min(max_intervals, tick_max - tick_min)\n",
    "    raw_ticks = np.linspace(tick_min, tick_max, n_intervals + 1)\n",
    "    tick_vals = np.unique(np.rint(raw_ticks).astype(int))\n",
    "    if tick_vals[0] != tick_min:\n",
    "        tick_vals = np.insert(tick_vals, 0, tick_min)\n",
    "    if tick_vals[-1] != tick_max:\n",
    "        tick_vals = np.append(tick_vals, tick_max)\n",
    "    return tick_vals\n",
    "def _plot_taxa_contribution_on_axis(ax, otu, aa_archetypes, cfg):\n",
    "\n",
    "    comp = CompositionAnalyzer()\n",
    "    num_taxa = cfg.get(\"num_taxa\", 5)\n",
    "    arch_array = np.array(aa_archetypes)\n",
    "    archetype_names = [f\"Archetype {i+1}\" for i in range(len(arch_array))]\n",
    "    top_taxa = comp.analyze_top_taxa(\n",
    "        archetypes=arch_array,\n",
    "        feature_names=otu.columns,\n",
    "        archetype_names=archetype_names,\n",
    "        num_taxa=num_taxa,\n",
    "    )\n",
    "    all_top_taxa = set()\n",
    "    for arch_data in top_taxa:\n",
    "        for _, taxa in arch_data[:-1]:\n",
    "            all_top_taxa.add(taxa)\n",
    "    all_top_taxa = sorted(list(all_top_taxa))\n",
    "    simplified_mapping = comp.simplify_taxa_names(all_top_taxa, max_length=18)\n",
    "    all_top_taxa = sorted(all_top_taxa, key=lambda x: simplified_mapping[x])\n",
    "    arch_df = pd.DataFrame(arch_array, columns=otu.columns, index=archetype_names)\n",
    "    taxa_percentages = comp._create_taxa_percentage_matrix(\n",
    "        arch_df, all_top_taxa, archetype_names\n",
    "    )\n",
    "    colors = comp._generate_distinct_colors(len(all_top_taxa))\n",
    "    comp._plot_stacked_bars(\n",
    "        ax=ax,\n",
    "        taxa_percentages=taxa_percentages,\n",
    "        all_top_taxa=all_top_taxa,\n",
    "        archetype_names=archetype_names,\n",
    "        colors=colors,\n",
    "        sort_by_contribution=True,\n",
    "        simplify_names=True,\n",
    "        max_name_length=18,\n",
    "        simplified_mapping=simplified_mapping,\n",
    "    )\n",
    "    from matplotlib.patches import Patch\n",
    "    legend_labels = [simplified_mapping[taxa] for taxa in all_top_taxa]\n",
    "    legend_handles = [\n",
    "        Patch(facecolor=colors[i], label=legend_labels[i])\n",
    "        for i in range(len(legend_labels))\n",
    "    ]\n",
    "    sorted_pairs = sorted(zip(legend_handles, legend_labels), key=lambda x: x[1])\n",
    "    sorted_handles = [h for h, _ in sorted_pairs]\n",
    "    sorted_labels = [l for _, l in sorted_pairs]\n",
    "    ax.legend(\n",
    "        sorted_handles,\n",
    "        sorted_labels,\n",
    "        loc=\"upper left\",\n",
    "        bbox_to_anchor=(1.01, 1),\n",
    "        fontsize=8,\n",
    "    )\n",
    "    ax.set_xlabel(\"Archetypes\")\n",
    "    ax.set_ylabel(\"Percentage Contribution (%)\")\n",
    "    ax.set_xticks(range(len(archetype_names)))\n",
    "    ax.set_xticklabels(archetype_names)\n",
    "    max_height = max(\n",
    "        [\n",
    "            sum([taxa_percentages[taxa][arch_idx] for taxa in all_top_taxa])\n",
    "            for arch_idx in range(len(archetype_names))\n",
    "        ]\n",
    "    )\n",
    "    ax.set_ylim(0, max_height * 1.1 if max_height > 0 else 100)\n",
    "    \n",
    "    \n",
    "def plot_consolidated_figure(cfg, layout_cfg=None, save_figure=True):\n",
    "\n",
    "    set_paper_style()\n",
    "    bundle = load_dataset_bundle(cfg)\n",
    "    plot_metadata = bundle[\"metadata\"].copy()\n",
    "    legend_title = cfg.get(\"legend_title\", cfg[\"metadata_col\"])\n",
    "    panel_cmap = cfg.get(\"panel_cmap\", \"tab20\")\n",
    "    simplex_cmap = cfg.get(\"simplex_cmap\", panel_cmap)\n",
    "    similarity_cmap = cfg.get(\"similarity_cmap\", panel_cmap)\n",
    "    pcoa_cmap = cfg.get(\"pcoa_cmap\", panel_cmap)\n",
    "    key_color_map = cfg.get(\"key_color_map\", None)\n",
    "    effective_key_color_map = key_color_map\n",
    "    discrete_key_cmap = None\n",
    "    key_to_color_idx = None\n",
    "    if cfg[\"legend_type\"] == \"discrete\":\n",
    "        col = cfg[\"metadata_col\"]\n",
    "        mask = plot_metadata[col].notna()\n",
    "        plot_metadata.loc[mask, col] = (\n",
    "            plot_metadata.loc[mask, col]\n",
    "            .astype(str)\n",
    "            .str.replace(r\"^\\s*\\d+\\s*[\\.\\):-]?\\s*\", \"\", regex=True)\n",
    "            .str.strip()\n",
    "        )\n",
    "        rename_map = cfg.get(\"label_rename_map\", None)\n",
    "        if rename_map:\n",
    "            plot_metadata.loc[mask, col] = plot_metadata.loc[mask, col].map(\n",
    "                lambda x: rename_map.get(x, x)\n",
    "            )\n",
    "    if (effective_key_color_map is None) and cfg[\"legend_type\"] == \"discrete\":\n",
    "        archetype_color_values = list(cfg.get(\"archetype_colors\", {}).values())\n",
    "        if len(archetype_color_values) > 0:\n",
    "            label_values = [\n",
    "                lbl for lbl in sorted(plot_metadata[cfg[\"metadata_col\"]].dropna().unique(), key=lambda x: str(x))\n",
    "            ]\n",
    "            cmap_for_arch = cm.get_cmap(simplex_cmap)\n",
    "            effective_key_color_map = {\n",
    "                lbl: resolve_archetype_color(\n",
    "                    archetype_color_values[i % len(archetype_color_values)],\n",
    "                    cmap_for_arch,\n",
    "                    default=0.5,\n",
    "                )\n",
    "                for i, lbl in enumerate(label_values)\n",
    "            }\n",
    "    if cfg[\"legend_type\"] == \"discrete\" and effective_key_color_map:\n",
    "        from matplotlib.colors import ListedColormap\n",
    "        labels_for_colors = [\n",
    "            lbl for lbl in sorted(plot_metadata[cfg[\"metadata_col\"]].dropna().unique(), key=lambda x: str(x))\n",
    "        ]\n",
    "        if len(labels_for_colors) > 0:\n",
    "            fallback_cmap = cm.get_cmap(panel_cmap, len(labels_for_colors))\n",
    "            color_list = [effective_key_color_map.get(lbl, fallback_cmap(i)) for i, lbl in enumerate(labels_for_colors)]\n",
    "            discrete_key_cmap = ListedColormap(color_list)\n",
    "            key_to_color_idx = {lbl: i for i, lbl in enumerate(labels_for_colors)}\n",
    "    layout = {\n",
    "        \"figsize\": (18, 10),\n",
    "        \"width_ratios\": [1.0, 1.0],\n",
    "        \"left_height_ratios\": [2.0, 1.0],\n",
    "        \"right_height_ratios\": [1.0, 1.0],\n",
    "        \"wspace\": 0.25,\n",
    "        \"left_hspace\": 0.24,\n",
    "        \"right_hspace\": 0.24,\n",
    "        \"pcoa_wspace\": 0.30,\n",
    "        \"simplex_x_offset\": 0.0,\n",
    "        \"simplex_width_scale\": 1.0,\n",
    "        \"stacked_x_offset\": -0.06,\n",
    "        \"stacked_width_scale\": 1.22,\n",
    "    }\n",
    "    if layout_cfg is not None:\n",
    "        layout.update(layout_cfg)\n",
    "    fig = plt.figure(figsize=layout[\"figsize\"])\n",
    "    gs = fig.add_gridspec(\n",
    "        1,\n",
    "        2,\n",
    "        width_ratios=layout[\"width_ratios\"],\n",
    "        wspace=layout[\"wspace\"],\n",
    "    )\n",
    "    left_gs = gs[0, 0].subgridspec(\n",
    "        2,\n",
    "        1,\n",
    "        height_ratios=layout[\"left_height_ratios\"],\n",
    "        hspace=layout[\"left_hspace\"],\n",
    "    )\n",
    "    right_gs = gs[0, 1].subgridspec(\n",
