    "            \"xtick.labelsize\": 9,\n",
    "            \"ytick.labelsize\": 9,\n",
    "            \"figure.dpi\": 300,\n",
    "            \"savefig.dpi\": 600,\n",
    "            \"savefig.bbox\": \"tight\",\n",
    "            \"axes.linewidth\": 0.8,\n",
    "            \"grid.alpha\": 0.22,\n",
    "            \"grid.linewidth\": 0.5,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "def save_current_figure(cfg, slug):\n",
    "    dataset_slug = (\n",
    "        cfg[\"title\"].lower().replace(\" \", \"_\").replace(\"(\", \"\").replace(\")\", \"\")\n",
    "    )\n",
    "    base = os.path.join(EXPORT_DIR, f\"{dataset_slug}_{slug}\")\n",
    "    plt.savefig(base + \".png\")\n",
    "    plt.savefig(base + \".pdf\")\n",
    "\n",
    "\n",
    "def read_table_auto(path):\n",
    "    if path.endswith(\".tsv\"):\n",
    "        return pd.read_table(path, index_col=0)\n",
    "    return pd.read_csv(path, index_col=0)\n",
    "\n",
    "\n",
    "def result_path(result_dir, k):\n",
    "    return os.path.join(result_dir, f\"otu_AA_K{k}_1.0_None_jensenshannon.json\")\n",
    "\n",
    "\n",
    "def build_uniform_archetype_colors(k):\n",
    "    return {f\"Archetype {i+1}\": (i + 1) / max(k, 1) for i in range(k)}\n",
    "\n",
    "\n",
    "def resolve_archetype_color(color_value, cmap, default=0.5):\n",
    "    if isinstance(color_value, (int, float, np.integer, np.floating)):\n",
    "        return cmap(float(color_value))\n",
    "    if color_value is None:\n",
    "        return cmap(default)\n",
    "    return color_value\n",
    "\n",
    "\n",
    "def reorder_similarity_and_archetypes(otu_aa, aa_archetypes, order_cols=None):\n",
    "    if order_cols is None:\n",
    "        return otu_aa.copy(), np.array(aa_archetypes)\n",
    "    reordered = otu_aa[order_cols].copy()\n",
    "    renamed_cols = [f\"Archetype {i+1}\" for i in range(len(order_cols))]\n",
    "    reordered.columns = renamed_cols\n",
    "    idx = [int(c.split()[-1]) - 1 for c in order_cols]\n",
    "    aa_reordered = np.array(aa_archetypes)[idx, :]\n",
    "    return reordered, aa_reordered\n",
    "\n",
    "\n",
    "def build_metadata_for_samples(\n",
    "    sample_index, meta, metadata_col, tags=None, projects=None\n",
    "):\n",
    "    out = pd.DataFrame(index=sample_index)\n",
    "    # Hadza/Dog style: metadata column exists directly in sample table.\n",
    "    if metadata_col in meta.columns:\n",
    "        meta_local = meta.copy()\n",
    "        if not meta_local.index.is_unique:\n",
    "            meta_local = meta_local[~meta_local.index.duplicated(keep=\"first\")]\n",
    "        out[metadata_col] = meta_local.reindex(sample_index)[metadata_col]\n",
    "        return out\n",
    "    # Compendium style fallback using project/srr tags.\n",
    "    if (\"project\" in meta.columns) and (\"srr\" in meta.columns):\n",
    "        meta_local = meta.copy()\n",
    "        meta_local[\"sample\"] = (\n",
    "            meta_local[\"project\"].astype(str) + \"_\" + meta_local[\"srr\"].astype(str)\n",
    "        )\n",
    "        if not meta_local[\"sample\"].is_unique:\n",
    "            meta_local = meta_local.drop_duplicates(subset=\"sample\", keep=\"first\")\n",
    "        meta_local = meta_local.set_index(\"sample\")\n",
    "        if metadata_col in meta_local.columns:\n",
    "            out[metadata_col] = meta_local.reindex(sample_index)[metadata_col]\n",
    "            return out\n",
    "    # Compendium project-level metadata (e.g., sample_type in projects.csv).\n",
    "    if (projects is not None) and (metadata_col in projects.columns):\n",
    "        projects_local = projects.copy()\n",
    "        if not projects_local.index.is_unique:\n",
    "            projects_local = projects_local[\n",
    "                ~projects_local.index.duplicated(keep=\"first\")\n",
    "            ]\n",
    "        out[metadata_col] = [\n",
    "            (\n",
    "                projects_local.loc[s.split(\"_\")[0], metadata_col]\n",
    "                if (isinstance(s, str) and s.split(\"_\")[0] in projects_local.index)\n",
    "                else np.nan\n",
    "            )\n",
    "            for s in sample_index\n",
    "        ]\n",
    "        return out\n",
    "    # Compendium tag-level metadata (project+srr keyed long table).\n",
    "    if (tags is not None) and set([\"project\", \"srr\", \"tag\", \"value\"]).issubset(\n",
    "        tags.columns\n",
    "    ):\n",
    "        tag_rows = tags[tags[\"tag\"] == metadata_col].copy()\n",
    "        if len(tag_rows) > 0:\n",
    "            tag_rows[\"sample\"] = (\n",
    "                tag_rows[\"project\"].astype(str) + \"_\" + tag_rows[\"srr\"].astype(str)\n",
    "            )\n",
    "            if not tag_rows[\"sample\"].is_unique:\n",
    "                tag_rows = tag_rows.drop_duplicates(subset=\"sample\", keep=\"first\")\n",
    "            tag_map = tag_rows.set_index(\"sample\")[\"value\"]\n",
    "            out[metadata_col] = tag_map.reindex(sample_index)\n",
    "            return out\n",
    "    # Last-resort fill to keep plotting code stable.\n",
    "    out[metadata_col] = np.nan\n",
    "    return out\n",
    "\n",
    "\n",
    "def load_dataset_bundle(cfg):\n",
    "    loader = ArchetypalResultLoader()\n",
    "    otu = read_table_auto(cfg[\"otu_file\"])\n",
    "    meta = read_table_auto(cfg[\"meta_file\"])\n",
    "    projects = None\n",
    "    tags = None\n",
    "    if cfg.get(\"projects_file\"):\n",
    "        projects = pd.read_csv(cfg[\"projects_file\"], index_col=0)\n",
    "    if cfg.get(\"tags_file\"):\n",
    "        tags = pd.read_table(cfg[\"tags_file\"], index_col=0)\n",
    "    otu_aa, aa_labels, aa_archetypes, info = loader.load_parsed_result(\n",
    "        result_path(cfg[\"result_dir\"], cfg[\"main_k\"])\n",
    "    )\n",
    "    otu_aa, aa_archetypes = reorder_similarity_and_archetypes(\n",
    "        otu_aa, aa_archetypes, cfg.get(\"archetype_order\")\n",
    "    )\n",
    "    metadata = build_metadata_for_samples(\n",
    "        sample_index=otu_aa.index,\n",
    "        meta=meta,\n",
    "        metadata_col=cfg[\"metadata_col\"],\n",
    "        tags=tags,\n",
    "        projects=projects,\n",
    "    )\n",
    "    return {\n",
    "        \"otu\": otu,\n",
    "        \"meta\": meta,\n",
    "        \"projects\": projects,\n",
    "        \"tags\": tags,\n",
    "        \"otu_aa\": otu_aa,\n",
    "        \"aa_labels\": aa_labels,\n",
    "        \"aa_archetypes\": aa_archetypes,\n",
    "        \"info\": info,\n",
    "        \"metadata\": metadata,\n",
    "    }\n",
    "\n",
    "\n",
    "def plot_pcoa_panel(otu, aa_archetypes, metadata, cfg):\n",
    "    pcoa_visualizer = PCoAVisualizer()\n",
    "    arch_df = pd.DataFrame(\n",
    "        aa_archetypes,\n",
    "        columns=otu.columns,\n",
    "        index=[f\"Archetype {i+1}\" for i in range(len(aa_archetypes))],\n",
    "    )\n",
    "    otu_with_archs = pd.concat([otu, arch_df], axis=0)\n",
    "    pcoa_coords, pcoa_results = pcoa_visualizer.create_pcoa_from_otu(\n",
    "        otu_data=otu_with_archs,\n",
    "        distance_metric=\"jensenshannon\",\n",
    "        n_dimensions=3,\n",
    "        apply_log_transform=True,\n",
    "        clean_data=True,\n",
    "        verbose=False,\n",
    "    )\n",
    "    fig, axs = pcoa_visualizer.plot_pcoa(\n",
    "        pcoa_coordinates=pcoa_coords,\n",
    "        pcoa_results=pcoa_results,\n",
    "        metadata=metadata,\n",
    "        filter_col=cfg[\"metadata_col\"],\n",
    "        legend_type=cfg[\"legend_type\"],\n",
    "        figsize=(9.5, 4.9),\n",
    "        alpha=0.72,\n",
    "        s=18,\n",
    "        pc_combinations=[(\"PC1\", \"PC2\"), (\"PC2\", \"PC3\")],  # ('PC1', 'PC3')],\n",
    "        cmap_name=cfg[\"cmap\"],\n",
    "    )\n",
    "    arch_coords = pcoa_coords.loc[arch_df.index]\n",
    "    arch_cmap = cm.get_cmap(cfg[\"cmap\"])\n",
    "    arch_color_map = cfg[\"archetype_colors\"]\n",
    "    for ax, (x_pc, y_pc) in zip(axs, [(\"PC1\", \"PC2\"), (\"PC2\", \"PC3\")]):\n",
    "        for arch_name, row in arch_coords.iterrows():\n",
    "            ax.scatter(\n",
    "                row[x_pc],\n",
    "                row[y_pc],\n",
    "                marker=\"X\",\n",
    "                s=275,\n",
    "                color=resolve_archetype_color(\n",
    "                    arch_color_map.get(arch_name, None), arch_cmap, default=0.5\n",
    "                ),\n",
    "                edgecolor=\"black\",\n",
    "                linewidth=0.7,\n",
    "                zorder=5,\n",
    "            )\n",
    "            # ax.text(row[x_pc], row[y_pc], arch_name, fontsize=8)\n",
    "    # Bold font\n",
    "    fig.suptitle(f\"{cfg['title']}: PCoA Component Comparisons\", y=1.02, fontweight=\"semibold\")\n",
    "    plt.tight_layout()\n",
    "    save_current_figure(cfg, \"pcoa_panel\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def plot_scores_vs_k(cfg, metadata, loader):\n",
    "    k_values = cfg[\"k_values\"]\n",
    "    results = loader.load_multiple_results(\n",
    "        k_values=k_values, directory=cfg[\"result_dir\"]\n",
    "    )\n",
    "    metrics = AnalysisMetrics()\n",
    "    comp = metrics.compare_archetype_quality(\n",
    "        results_dict=results,\n",
    "        metadata=metadata,\n",
    "        metadata_column=cfg[\"metadata_col\"],\n",
    "        discretize=cfg.get(\"discretize_scores\", False),\n",
    "        buckets=cfg.get(\"score_buckets\", None),\n",
    "        metrics=[\"silhouette\", \"davies_bouldin\"],\n",
    "    )\n",
    "    fig, ax1 = plt.subplots(figsize=(8.8, 4.9))\n",
    "    ax2 = ax1.twinx()\n",
    "    ax1.plot(\n",
    "        comp[\"k\"],\n",
    "        comp[\"silhouette\"],\n",
    "        color=\"#1f77b4\",\n",
    "        marker=\"o\",\n",
    "        linewidth=2,\n",
    "        label=\"Silhouette\",\n",
    "    )\n",
    "    ax2.plot(\n",
    "        comp[\"k\"],\n",
    "        comp[\"davies_bouldin\"],\n",
    "        color=\"#d62728\",\n",
    "        marker=\"s\",\n",
    "        linewidth=2,\n",
    "        label=\"Davies-Bouldin\",\n",
    "    )\n",
    "    ax1.set_xlabel(\"Number of archetypes (K)\")\n",
    "    ax1.set_ylabel(\"Silhouette score\", color=\"#1f77b4\")\n",
    "    ax2.set_ylabel(\"Davies-Bouldin score\", color=\"#d62728\")\n",
    "    ax1.set_title(\n",
    "        f\"{cfg['title']}: Davies-Bouldin + Silhouette vs Number of Archetypes\"\n",
    "    )\n",
    "    ax1.grid(True, alpha=0.25)\n",
    "    lines = ax1.get_lines() + ax2.get_lines()\n",
    "    labels = [l.get_label() for l in lines]\n",
    "    ax1.legend(lines, labels, loc=\"best\", frameon=True)\n",
    "    plt.tight_layout()\n",
    "    save_current_figure(cfg, \"scores_vs_k\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def plot_simplex_panel(otu_aa, metadata, cfg):\n",
    "    simplex_plotter = SimplexPlotter()\n",
    "    plot_metadata = metadata.copy()\n",
    "    discrete_key_cmap = None\n",
    "    key_to_color_idx = None\n",
    "    key_color_map = cfg.get(\"key_color_map\", None)\n",
    "    if key_color_map is None:\n",
    "        # Backward compatibility for configs where key_color_map was nested.\n",
    "        key_color_map = cfg.get(\"label_rename_map\", {}).get(\"key_color_map\", None)\n",
    "    if cfg[\"legend_type\"] == \"discrete\":\n",
    "        col = cfg[\"metadata_col\"]\n",
    "        mask = plot_metadata[col].notna()\n",
    "        plot_metadata.loc[mask, col] = (\n",
    "            plot_metadata.loc[mask, col]\n",
    "            .astype(str)\n",
    "            .str.replace(r\"^\\s*\\d+\\s*[\\.\\):-]?\\s*\", \"\", regex=True)\n",
    "            .str.strip()\n",
    "        )\n",
    "        rename_map = cfg.get(\"label_rename_map\", None)\n",
    "        if rename_map:\n",
    "            plot_metadata.loc[mask, col] = plot_metadata.loc[mask, col].map(\n",
    "                lambda x: rename_map.get(x, x)\n",
    "            )\n",
    "        if key_color_map:\n",
    "            from matplotlib.colors import ListedColormap\n",
    "\n",
    "            labels_for_colors = [\n",
    "                lbl\n",
    "                for lbl in sorted(\n",
    "                    plot_metadata[cfg[\"metadata_col\"]].dropna().unique(),\n",
    "                    key=lambda x: str(x),\n",
    "                )\n",
    "            ]\n",
    "            if len(labels_for_colors) > 0:\n",
    "                fallback_cmap = cm.get_cmap(cfg[\"cmap\"], len(labels_for_colors))\n",
    "                color_list = [\n",
    "                    key_color_map.get(lbl, fallback_cmap(i))\n",
    "                    for i, lbl in enumerate(labels_for_colors)\n",
    "                ]\n",
    "                discrete_key_cmap = ListedColormap(color_list)\n",
    "                key_to_color_idx = {lbl: i for i, lbl in enumerate(labels_for_colors)}\n",
    "    simplex_plotter.plot_simplex(\n",
    "        otu_aa=otu_aa,\n",
    "        metadata=plot_metadata,\n",
    "        filter_cols=[cfg[\"metadata_col\"]],\n",
    "        cmap_name=discrete_key_cmap if discrete_key_cmap is not None else cfg[\"cmap\"],\n",
    "        legend_type=cfg[\"legend_type\"],\n",
    "        remove_nan=True,\n",
    "        alpha=0.76,\n",
    "        s=30,\n",
    "        figsize=(8.7, 8.0),\n",
    "        remove_values=cfg.get(\"remove_values\", {}),\n",
    "        legend_fontsize=9,\n",
    "        custom_colors=key_to_color_idx if key_to_color_idx is not None else None,\n",
    "        show_direction=False,\n",
    "        direction_alpha=0,\n",
    "    )\n",
    "    if cfg[\"legend_type\"] == \"continuous\":\n",
    "        vals = pd.to_numeric(plot_metadata[cfg[\"metadata_col\"]], errors=\"coerce\")\n",
    "        vals = vals[np.isfinite(vals)]\n",
    "        if len(vals) > 0 and len(plt.gcf().axes) > 1:\n",
    "            min_val = float(np.nanmin(vals))\n",
    "            max_val = float(np.nanmax(vals))\n",
    "            tick_min = int(np.rint(min_val))\n",
    "            tick_max = int(np.rint(max_val))\n",
    "            if tick_min > tick_max:\n",
    "                tick_min, tick_max = tick_max, tick_min\n",
    "            if tick_min == tick_max:\n",
    "                tick_vals = np.array([tick_min], dtype=int)\n",
    "            else:\n",
    "                n_intervals = min(6, tick_max - tick_min)\n",
    "                raw_ticks = np.linspace(tick_min, tick_max, n_intervals + 1)\n",
    "                tick_vals = np.unique(np.rint(raw_ticks).astype(int))\n",
    "                if tick_vals[0] != tick_min:\n",
    "                    tick_vals = np.insert(tick_vals, 0, tick_min)\n",
    "                if tick_vals[-1] != tick_max:\n",
    "                    tick_vals = np.append(tick_vals, tick_max)\n",
    "            cax = plt.gcf().axes[-1]\n",
    "            cax.set_yticks(tick_vals)\n",
    "            cax.set_yticklabels([f\"{int(v)}\" for v in tick_vals])\n",
    "            cax.set_ylabel(cfg.get(\"colorbar_title\", cfg[\"metadata_col\"]))\n",
    "    plt.title(f\"{cfg['title']}: Archetypal Analysis Simplex\")\n",
    "    plt.tight_layout()\n",
    "    save_current_figure(cfg, \"simplex\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def plot_similarity_stacked(otu_aa, info, metadata, cfg):\n",
    "    stacked = StackedBarPlotter()\n",
    "    stacked.plot_metadata_stacked_bars(\n",
    "        similarity_degree=otu_aa,\n",
    "        metadata=metadata,\n",
    "        perms=info.get(\"perms\", None),\n",
    "        metadata_column=cfg[\"metadata_col\"],\n",
    "        discretize=cfg.get(\"discretize_stacked\", False),\n",
    "        buckets=cfg.get(\"stacked_buckets\", None),\n",
    "        cmap_name=cfg[\"cmap\"],\n",
    "        vertex_colors=cfg[\"archetype_colors\"],\n",
    "        figsize=(11.6, 4.0),\n",
    "        alpha=0.9,\n",
    "    )\n",
    "    plt.title(f\"{cfg['title']}: Similarity Degree Stacked Bar\")\n",
    "    plt.tight_layout()\n",
    "    save_current_figure(cfg, \"stacked_bar\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def plot_taxa_contribution(otu, aa_archetypes, cfg):\n",
    "    comp = CompositionAnalyzer()\n",
    "    top_taxa = comp.analyze_top_taxa(\n",
    "        archetypes=np.array(aa_archetypes),\n",
    "        feature_names=otu.columns,\n",
    "        num_taxa=cfg.get(\"num_taxa\", 5),\n",
    "    )\n",
    "\n",
    "    comp.plot_stacked_bar_chart(\n",
    "        aa_archetypes=np.array(aa_archetypes),\n",
    "        feature_names=otu.columns,\n",
    "        top_taxa_archetypes=top_taxa,\n",
    "        figsize=(10.8, 5.9),\n",
    "        sort_by_contribution=True,\n",
    "        simplify_names=True,\n",
    "        max_name_length=18,\n",
    "    )\n",
    "    plt.title(f\"{cfg['title']}: Taxa Contribution Bar Plot\")\n",
    "    plt.tight_layout()\n",
    "    save_current_figure(cfg, \"taxa_contribution\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def run_all_plots_for_dataset(cfg):\n",
    "    set_paper_style()\n",
    "    loader = ArchetypalResultLoader()\n",
    "    bundle = load_dataset_bundle(cfg)\n",
    "\n",
    "    plot_pcoa_panel(bundle[\"otu\"], bundle[\"aa_archetypes\"], bundle[\"metadata\"], cfg)\n",
    "    plot_scores_vs_k(cfg, bundle[\"metadata\"], loader)\n",
    "    plot_simplex_panel(bundle[\"otu_aa\"], bundle[\"metadata\"], cfg)\n",
    "    plot_similarity_stacked(bundle[\"otu_aa\"], bundle[\"info\"], bundle[\"metadata\"], cfg)\n",
    "    plot_taxa_contribution(bundle[\"otu\"], bundle[\"aa_archetypes\"], cfg)\n",
    "\n",
    "\n",
    "DATASET_CONFIGS_PATH = os.path.join(ROOT, \"dataset_configs.json\")\n",
    "\n",
    "\n",
    "def load_dataset_configs(path=DATASET_CONFIGS_PATH):\n",
    "    with open(path, \"r\") as f:\n",
    "        return json.load(f)\n",
    "\n",
    "\n",
    "DATASET_CONFIGS = load_dataset_configs()\n",
    "\n",
    "\n",
    "print(\"Plotters ready. Figures will also be exported to:\", EXPORT_DIR)"
   ]
